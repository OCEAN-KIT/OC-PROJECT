{
  "name": "oc-project",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev:record": "pnpm --filter @ocean-kit/oc-record dev",
    "dev:dashboard": "pnpm --filter @ocean-kit/oc-dashboard dev",
    "dev:admin": "pnpm --filter @ocean-kit/oc-admin dev",
    "dev:admin-next": "pnpm --filter @ocean-kit/oc-admin-next dev",
    "dev:mock-api": "pnpm --filter @ocean-kit/oc-mock-api dev",
    "build": "turbo build --filter=@ocean-kit/oc-admin --filter=@ocean-kit/oc-dashboard --filter=@ocean-kit/oc-record",
    "lint": "turbo lint --filter=@ocean-kit/oc-admin --filter=@ocean-kit/oc-dashboard --filter=@ocean-kit/oc-record",
    "typecheck": "turbo typecheck --filter=@ocean-kit/dashboard-domain --filter=@ocean-kit/shared-auth --filter=@ocean-kit/shared-axios --filter=@ocean-kit/shared-types --filter=@ocean-kit/submission-domain",
    "check": "turbo run lint build --filter=@ocean-kit/oc-admin --filter=@ocean-kit/oc-dashboard --filter=@ocean-kit/oc-record"
  },
  "devDependencies": {
    "@types/node": "^20",
    "nx": "^22.7.3",
    "turbo": "^2.9.6",
    "typescript": "^5"
  }
}
