{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "#/*": ["./src/*"],
      "next/navigation": ["./src/shared/next-compat/navigation.ts"],
      "next/link": ["./src/shared/next-compat/link.tsx"]
    }
  },
  "include": [
    "vite.config.ts",
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "**/*.js",
    "**/*.jsx"
  ],
  "exclude": ["node_modules", "dist", ".next"]
}
